@model Application.Dtos.AdvertDtos.AdvertDetailsDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <!-- Галерея изображений -->
            <div id="advertCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @foreach (var imageUrl in Model.ImageUrls)
                    {
                        <div class="carousel-item @(imageUrl == Model.ImageUrls.First() ? "active" : "")">
                            <img src="@imageUrl" class="d-block w-100 rounded" style="max-height: 500px; object-fit: contain;" alt="Фото объявления">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#advertCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#advertCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>

            <!-- Описание -->
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">@Model.Title</h2>
                    <p class="text-muted">@Model.CityName, @Model.CategoryName</p>
                    <h3 class="text-primary my-3">@Model.Price.ToString("C")</h3>
                    <hr>
                    <p class="card-text">@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Контактная информация -->
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Контактная информация</h5>
                    <hr>
                    <p class="card-text"><strong>Телефон:</strong> @Model.ContactPhone</p>
                    <p class="card-text"><small class="text-muted">Дата публикации: @Model.CreatedAt.ToString("dd.MM.yyyy")</small></p>
                </div>
            </div>
        </div>
    </div>
</div>