@model Application.Dtos.AdvertDtos.UpdateAdvertDto
@{
    ViewData["Title"] = "Редактирование объявления";
    Layout = "_AdminLayout";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="EditAdvert" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    
    <div class="form-group">
        <label asp-for="Title">Заголовок</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    
    <div class="form-group mt-3">
        <label asp-for="Description">Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    
    <div class="form-group mt-3">
        <label asp-for="Price">Цена</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    
    <div class="form-group mt-3">
        <label asp-for="ContactPhone">Контактный телефон</label>
        <input asp-for="ContactPhone" class="form-control" />
        <span asp-validation-for="ContactPhone" class="text-danger"></span>
    </div>
    
    <div class="form-group mt-3">
        <label asp-for="CityId">Город</label>
        <select asp-for="CityId" asp-items="@(new SelectList(ViewBag.Cities, "Id", "Name"))" class="form-control"></select>
    </div>
    
    <div class="form-group mt-3">
        <label asp-for="CategoryId">Категория</label>
        <select asp-for="CategoryId" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))" class="form-control"></select>
    </div>
    
    <div class="form-group mt-3">
        <label>Новые изображения</label>
        <input type="file" name="NewImages" multiple class="form-control" />
    </div>
    
    <button type="submit" class="btn btn-primary mt-3">Сохранить</button>
</form>