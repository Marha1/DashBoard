@model List<Application.Dtos.CategoryDtos.CategoryDto>
@{
    ViewData["Title"] = "Управление категориями";
    Layout = "_AdminLayout";
}

<h2>@ViewData["Title"]</h2>

<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Название</th>
        <th>Родительская категория</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.Id</td>
            <td>@category.Name</td>
            <td>@(category.ParentId?.ToString() ?? "-")</td>
            <td>
                <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-sm btn-warning">Редактировать</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="CreateCategory" class="btn btn-success">Добавить категорию</a>