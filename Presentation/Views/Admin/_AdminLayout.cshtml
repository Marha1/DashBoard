@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Админ-панель</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .admin-container { padding: 20px; }
        .admin-links { display: flex; gap: 10px; margin-top: 20px; }
        .navbar-nav { align-items: center; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Admin" asp-action="Index">Админ-панель</a>
                <div class="navbar-nav">
                    <a class="nav-link" asp-controller="Admin" asp-action="Cities">Города</a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Categories">Категории</a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Adverts">Объявления</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link btn btn-link">Выйти</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main class="container">
        <!-- Диагностическая информация -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="alert alert-info mt-3">
                <p>Аутентифицирован как: @User.Identity.Name</p>
                <p>Роли: @string.Join(", ", User.FindAll(ClaimTypes.Role).Select(c => c.Value))</p>
            </div>
        }
        
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>